# Copy to .env and adjust.

DATABASE_URL=postgresql+psycopg2://polarsphere:polarsphere@localhost:5433/polarsphere

# Embeddings (semantic search + RAG retrieval)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# Local generator for RAG. No API key required.
LLM_BACKEND=local
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.2
LLM_PRELOAD=1
# CPU inference threads. 4 measured ~6x faster than 16 for a 1.5B model. Do not raise.
LLM_THREADS=4

# Set only if you later swap in a hosted provider (LLM_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS origins for the Next.js frontend, comma separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
